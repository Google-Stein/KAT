# Copy to .env in the repository root. Never commit .env or paste keys into chat.
# Used by the desktop launcher in development and by Core with --env-file .env.
# OPENAI_API_KEY is sent only by the Core's OpenAI adapter.
OPENAI_API_KEY=
# Cloud proxy secret bindings use this supported alias (takes precedence when set).
# KAT_OPENAI_API_KEY=

# Optional standalone Core settings (desktop supplies its own runtime token).
# KAT_DATA_DIR=C:\Users\YOUR_NAME\AppData\Local\KAT
# KAT_API_TOKEN=generate-a-long-random-token-do-not-use-this-example
# Optional trusted application registrations. [] disables all app launches.
# KAT_APPLICATION_ALLOWLIST_JSON=[]
